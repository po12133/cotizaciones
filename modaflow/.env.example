# Copie este archivo como .env y complete los valores. El archivo .env NO se sube al repositorio.

# Clave de la API de Anthropic (https://platform.claude.com/settings/keys). Solo la usa el servidor.
ANTHROPIC_API_KEY=

# Modelo de Claude para analizar las fotos (Haiku: el más económico con visión)
IA_MODELO=claude-haiku-5-5

# Tarifa del modelo en USD por millón de tokens, para estimar el costo de cada análisis.
# Claude Haiku 5.5 (prompts de hasta 100K tokens): entrada 0.10, salida 0.50. Verifique en https://www.anthropic.com/pricing
# Si deja estas dos variables vacías, no se muestra costo.
IA_PRECIO_ENTRADA_USD_MTOK=0.10
IA_PRECIO_SALIDA_USD_MTOK=0.50
# Opcional: tipo de cambio referencial para mostrar el costo también en bolivianos
IA_TIPO_CAMBIO_BS=6.96

# Controles básicos contra solicitudes excesivas
IA_LIMITE_POR_MINUTO=6
IA_LIMITE_DIARIO=200
IA_CONCURRENCIA=2

# Servidor local. En Coolify/Docker NO copie PORT ni HOST: el Dockerfile ya usa el puerto 8080 y escucha en todas las interfaces.
# En local, use HOST=0.0.0.0 para probar desde el celular en la misma red Wi-Fi.
PORT=8080
HOST=127.0.0.1

# Solo para producción detrás de un proxy (Coolify): usar la IP real del visitante para los límites
TRUST_PROXY=0
# Solo si las páginas se sirven desde OTRO dominio (sitio estático) y llaman a esta API:
# lista separada por comas, p. ej. https://cotizaciones.midominio.com
IA_CORS_ORIGENES=
